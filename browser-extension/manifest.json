{
  "manifest_version": 3,
  "name": "Grace Planner · ChatGPT Browser Bridge",
  "version": "0.2.0",
  "description": "Pair one Grace Planner chat with your own signed-in ChatGPT tab. Uses visible browser controls, without API keys.",
  "permissions": ["storage"],
  "host_permissions": ["https://chatgpt.com/*", "https://graceplanner.vercel.app/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_popup": "popup.html", "default_title": "Pair Grace Planner with ChatGPT"},
  "content_scripts": [
    {"matches": ["https://graceplanner.vercel.app/*"], "js": ["site.js"], "run_at": "document_idle"},
    {"matches": ["https://chatgpt.com/*"], "js": ["chatgpt.js"], "run_at": "document_idle"}
  ]
}
